// ===== Hunting queries (run ad hoc; not scheduled rules). Status: needs_validation =====

// --- H-AGT-007  Zammad CVE-2026-102489 session material in error output -------------------------
// DIVD-2026-00015's own IoC check (cve-2026-102489_ioc_check_script_v2.sh) greps production.log,
// railsserver.log, websocket.log, scheduler.log and nginx logs for this. Ship those logs as Syslog or a
// custom table first; <ZAMMAD_TABLE>/<RAW_COLUMN> are yours (e.g. Syslog/SyslogMessage).
<ZAMMAD_TABLE>
| where TimeGenerated > ago(60d)
| where <RAW_COLUMN> matches regex @'ERROR -- :.*("Cookie"=>"|@clients=\{)'
| extend Cookie = extract(@'"Cookie"=>"([^"]*)"', 1, <RAW_COLUMN>)
| summarize Hits = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Cookies = make_set(Cookie, 20) by Computer

// --- H-AGT-010  Slow enumeration trajectory (port of Morpheus R-P-L7-010) ----------------------
// Daily distinct paths per client climbing on a straight line while its busiest 10-minute window stays
// under R-D-AGT-001's 200-path floor (same guard as the Splunk rule's peak lookup).
let web = _Im_WebSession(starttime=ago(14d)) | extend Path = tostring(parse_url(Url).Path);
let peak10 = web | summarize Paths = dcount(Path) by SrcIpAddr, bin(TimeGenerated, 10m) | summarize Peak10m = max(Paths) by SrcIpAddr;
web
| make-series Paths = dcount(Path) default = 0 on TimeGenerated step 1d by SrcIpAddr
| extend (RSquare, Slope, Variance, RVariance, Interception, LineFit) = series_fit_line(Paths)
| extend PeakDay = toint(series_stats_dynamic(Paths).max)
| join kind=inner peak10 on SrcIpAddr
| where Slope >= 10 and RSquare >= 0.8 and Peak10m <= 200
| project SrcIpAddr, Slope = round(Slope, 1), RSquare = round(RSquare, 3), PeakDay, Peak10m, Paths

// --- H-AGT-011  Off-hours concentration (Morpheus tc5_cadence idea; CERT-In: weekends/holidays) --
// Share of a principal's sign-ins falling on Sat/Sun or 22:00-06:00 local this week vs its own prior share.
let local_offset = 0h;  // set to your time zone offset
SigninLogs
| where TimeGenerated > ago(14d) and ResultType == "0"
| extend T = TimeGenerated + local_offset
| extend OffHours = dayofweek(T) in (0d, 6d) or hourofday(T) >= 22 or hourofday(T) < 6
| extend Period = iff(TimeGenerated > ago(7d), "this_week", "prior")
| summarize Share = round(todouble(countif(OffHours)) / count(), 3), N = count() by UserPrincipalName, Period
| summarize ThisWeek = take_anyif(Share, Period == "this_week"), Prior = take_anyif(Share, Period == "prior"), N = sum(N) by UserPrincipalName
| where ThisWeek >= 0.5 and Prior < 0.1

// --- H-AGT-012  Service-principal sign-in burst. Huntress observed a 100-tenant token-request burst
// from the hijacked ConnectWise apps, one request per tenant one to six minutes apart (2026-10); the
// 50-per-5-minute threshold below is deliberately lower so it also catches a slower variant - tune up if noisy.
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(14d)
| summarize SignIns = count(), Ips = dcount(IPAddress), Resources = make_set(ResourceDisplayName, 10) by AppId, ServicePrincipalName, bin(TimeGenerated, 5m)
| where SignIns > 50
| order by SignIns desc

// --- H-AGT-013  Script files written into web roots by the web server (polyglot upload) ---------
DeviceFileEvents
| where TimeGenerated > ago(14d)
| where InitiatingProcessFileName in~ ("w3wp.exe","php-cgi.exe","httpd.exe","java.exe","node.exe","php-fpm","apache2","httpd","nginx","java","node")
| where FileName matches regex @"(?i)\.(php|phtml|php5|phar|jsp|jspx|aspx|ashx|asmx)$"
| project TimeGenerated, DeviceName, FolderPath, FileName, InitiatingProcessFileName, SHA256

// --- H-AGT-014  CyberStrikeAI implant artifacts (Kaspersky Securelist 2026-11-02) -------------
// Beacon and tool names, the SystemUpdate persistence pair, comsvcs MiniDump of LSASS and certutil
// payload decoding, scored by how many distinct signals a host shows. The strongest network tell,
// the X-Implant-Token header on every implant HTTP request, needs proxy or NDR logs that keep
// request headers, so it is not queried here.
let names = dynamic(["svchosts.exe", "svcmon32.exe", "wdiag2.exe"]);
union
  (DeviceFileEvents | where TimeGenerated > ago(30d) | where FileName in~ (names)
     | project TimeGenerated, DeviceName, Signal = strcat("file ", tolower(FileName)), Detail = FolderPath),
  (DeviceProcessEvents | where TimeGenerated > ago(30d)
     | where (FileName =~ "schtasks.exe" and ProcessCommandLine has "SystemUpdate" and ProcessCommandLine has "create")
          or (FileName =~ "rundll32.exe" and ProcessCommandLine has "comsvcs" and ProcessCommandLine has "MiniDump")
          or (FileName =~ "certutil.exe" and ProcessCommandLine has "decode")
     | project TimeGenerated, DeviceName, Signal = tolower(FileName), Detail = ProcessCommandLine),
  (DeviceRegistryEvents | where TimeGenerated > ago(30d)
     | where RegistryKey has @"\CurrentVersion\Run" and RegistryValueName =~ "SystemUpdate"
     | project TimeGenerated, DeviceName, Signal = "run value SystemUpdate", Detail = RegistryValueData)
| summarize Signals = make_set(Signal, 10), Details = make_set(Detail, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by DeviceName
| extend SignalCount = array_length(Signals)
| order by SignalCount desc

// --- H-AGT-015  Framework self-telemetry on egress (STRIX, CyberStrikeAI, PentAGI) ------------
// These strings go to the frameworks' OWN LLM/observability/update endpoints, not to the target,
// so STRIX's strip-markers prompt rule does not remove them. The header matches need a proxy that
// logs request headers (<PROXY_HEADERS_TABLE>, e.g. a Zscaler/Netskope custom table or Defender
// for Cloud Apps); the domain and user-agent matches run on standard tables. A host of yours
// emitting any of these is likely running the framework.
let fw_hosts = dynamic(["strix.ai", "strix.gateway.scarf.sh", "update.pentagi.com", "support.pentagi.com"]);
let fw_ua = dynamic(["langfuse golang sdk", "artex-selfupdate"]);
union isfuzzy=true
  (DeviceNetworkEvents | where TimeGenerated > ago(30d) | extend u = tolower(RemoteUrl)
     | extend Domain = iff(u has "://", tostring(parse_url(u).Host), tostring(split(u, "/")[0]))
     | where Domain in (fw_hosts)
     | project TimeGenerated, DeviceName, Signal = strcat("egress ", Domain), Detail = InitiatingProcessCommandLine),
  (_Im_WebSession(starttime=ago(30d)) | where HttpUserAgent in (fw_ua)
     | project TimeGenerated, DeviceName = SrcHostname, Signal = strcat("user-agent ", HttpUserAgent), Detail = Url),
  // Header matches: enable only if your proxy logs request headers. Replace the table and column.
  (<PROXY_HEADERS_TABLE> | where TimeGenerated > ago(30d)
     | where <REQUEST_HEADERS_COLUMN> has "X-CyberStrike-Summarization"
          or (<REQUEST_HEADERS_COLUMN> has "X-Title: Strix" and <REQUEST_HEADERS_COLUMN> has "strix.ai")
     | project TimeGenerated, DeviceName = <CLIENT_COLUMN>, Signal = "framework LLM header", Detail = <URL_COLUMN>)
| summarize Signals = make_set(Signal, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by DeviceName
| order by LastSeen desc

// --- H-AGT-016  OAuth application user-agent drift (Huntress ConnectWise method) --------------
// The compromised ConnectWise apps normally call Graph as kiota-dotnet; the operator's token loop
// used Python-urllib/3.12, one request per tenant a few minutes apart. Baseline each watched app's
// user-agent over the prior 14 days and alert when a new one appears in the last 24 hours. Needs
// the Microsoft Graph activity logs connector. App IDs are the compromised ConnectWise ones.
let watched = dynamic(["506e08f9-6e9a-4da4-942b-a099a03644ae", "24205314-2b89-4e07-a2a4-579e898a5640", "0de14c77-b9b0-4137-9360-34878a929827"]);
let baseline = MicrosoftGraphActivityLogs
    | where TimeGenerated between (ago(14d) .. ago(1d)) and AppId in (watched)
    | summarize KnownAgents = make_set(UserAgent) by AppId;
MicrosoftGraphActivityLogs
| where TimeGenerated > ago(1d) and AppId in (watched)
| summarize Requests = count(), Tenants = dcount(TenantId), IPs = make_set(IPAddress, 20), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by AppId, UserAgent
| join kind=leftouter baseline on AppId
| where isnull(KnownAgents) or UserAgent !in (KnownAgents)
| project AppId, NewUserAgent = UserAgent, Requests, Tenants, IPs, FirstSeen, LastSeen
| order by Tenants desc


// --- H-AGT-017  Spec-driven API targeting (Unit 42 2026-10-30) ---------------------------------
// A source map / OpenAPI / docs download followed within two minutes by five or more distinct /api/
// routes from the same source, with no wordlist brute force in between: the agent reads the spec
// and calls only what it defines. Unit 42 saw the first spec-defined call two seconds after download.
let specs = _Im_WebSession(starttime=ago(7d))
    | where Url matches regex @"(?i)\.js\.map(\?|$)|/openapi\.json|/redoc|/docs(/|$)|/swagger"
    | summarize SpecTime = min(TimeGenerated), SpecUrls = make_set(Url, 5) by SrcIpAddr, Dst = coalesce(DstHostname, DstIpAddr);
_Im_WebSession(starttime=ago(7d))
| where Url contains "/api/"
| summarize ApiTime = min(TimeGenerated), ApiUrls = dcount(Url), Requests = count() by SrcIpAddr, Dst = coalesce(DstHostname, DstIpAddr)
| join kind=inner specs on SrcIpAddr, Dst
| where ApiTime >= SpecTime and ApiTime - SpecTime <= 2m and ApiUrls >= 5
| project SrcIpAddr, Dst, SpecTime, SecondsToFirstApiCall = datetime_diff("second", ApiTime, SpecTime), ApiUrls, Requests, SpecUrls
| order by SecondsToFirstApiCall asc

// --- H-AGT-018  Canary username, then a privileged account (Unit 42 2026-10-30) -----------------
// The agent logs in as a generated nonexistent user (zz_no_such_user_9f3a, zzq.nonexistent9x7) to
// baseline the error response, then one second later as admin. Entra sign-ins shown; the same
// shape applies to any IdP or web login log.
SigninLogs
| where TimeGenerated > ago(30d) and ResultType != "0"
| extend u = tolower(UserPrincipalName)
| extend Kind = case(u startswith "zz" or u contains "nonexistent" or u contains "not-a-user", "canary",
                     u startswith "admin" or u startswith "root@", "admin", "")
| where Kind != ""
| summarize CanaryTime = minif(TimeGenerated, Kind == "canary"), AdminTime = minif(TimeGenerated, Kind == "admin"),
            CanaryUsers = make_set_if(UserPrincipalName, Kind == "canary", 5), AdminUsers = make_set_if(UserPrincipalName, Kind == "admin", 5) by IPAddress
| where isnotnull(CanaryTime) and isnotnull(AdminTime) and AdminTime >= CanaryTime and AdminTime - CanaryTime <= 1m
| project IPAddress, CanaryTime, SecondsToAdmin = datetime_diff("second", AdminTime, CanaryTime), CanaryUsers, AdminUsers

// --- H-AGT-019  ARTEX task artifacts on a compromised host (S-RM 2026-11-04) -------------------
// S-RM found /opt/artex/data/task/<task>/i4028/i4028.asp on a victim, disposable GitHub branches
// named artex-wtest-<n>, and placeholder emails at example.invalid. The i<number> is the agent's
// intent counter, so hunt the shape, not one name. ScopeWeaver (an ARTEX derivative) renames the
// binary and its variables; both are included.
union
  (DeviceFileEvents | where TimeGenerated > ago(30d)
     | where FolderPath contains "/opt/artex" or FolderPath contains @"\artex\data\task" or FileName matches regex @"^i[0-9]{3,5}\.(asp|aspx|php|jsp|jspx)$"
     | project TimeGenerated, DeviceName, Signal = "task artifact", Detail = strcat(FolderPath, " ", FileName)),
  (DeviceProcessEvents | where TimeGenerated > ago(30d)
     | where ProcessCommandLine has_any ("artex-wtest-", "example.invalid", "SCOPEWEAVER_LLM_", "/opt/artex/") or FileName in~ ("scopeweaver", "scopeweaver.exe")
     | project TimeGenerated, DeviceName, Signal = "process", Detail = ProcessCommandLine)
| summarize Signals = make_set(Signal, 5), Details = make_set(Detail, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by DeviceName
| order by LastSeen desc

// --- H-AGT-020  OAuth redirect-URI probing across many client IDs (Unit 42 2026-10-30) ---------
// Authorize requests with unregistered redirect URIs across a high number of application client IDs
// from one source. Unit 42's IdP returned illegal_redirect_uri_enhanced; the Entra equivalent is
// AADSTS50011 (reply URL mismatch), which is what is queried here.
SigninLogs
| where TimeGenerated > ago(7d) and ResultType == "50011"
| summarize Apps = dcount(AppId), Attempts = count(), Users = dcount(UserPrincipalName), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by IPAddress
| where Apps >= 5
| order by Apps desc
